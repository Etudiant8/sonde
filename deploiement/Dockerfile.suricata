# Image de capture : Suricata en écoute seule sur le port miroir.
FROM ubuntu:24.04

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      suricata suricata-update ca-certificates iproute2 \
 && rm -rf /var/lib/apt/lists/*

COPY deploiement/suricata/sonde.yaml /etc/suricata/sonde.yaml
COPY deploiement/suricata/demarrage.sh /usr/local/bin/demarrage.sh
# Nos réglages sont inclus à la fin de la configuration standard : ils la complètent
RUN echo "include: /etc/suricata/sonde.yaml" >> /etc/suricata/suricata.yaml \
 && chmod 755 /usr/local/bin/demarrage.sh

ENTRYPOINT ["/usr/local/bin/demarrage.sh"]
